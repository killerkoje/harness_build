# 선택 사항 — 없어도 issue-board-mcp는 정상 동작하고 Notion 동기화만 꺼진다.
# 채우려면 이 파일을 .env로 복사한 뒤 값을 넣는다: cp .env.example .env
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Supabase (kzmjqnngjzqgfvrrvjtz). 있으면 SQLite 대신 여기에 저장한다.
SUPABASE_URL=https://kzmjqnngjzqgfvrrvjtz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# DDL 자동 적용용 (Project Settings → Database → password). 없으면 SQL Editor에 migration 붙여넣기.
SUPABASE_DB_PASSWORD=
